      "name": "shopper profile",
      "item": [
        {
          "name": "Shopper Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "pm.test(\"Status code name has string\", function () {\r",
                  "    pm.response.to.have.status(\"OK\");\r",
                  "});\r",
                  "pm.test(\"Response time is less than 2000ms\", function () {\r",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
                  "});\r",
                  "body = JSON.parse(pm.response.text());\r",
                  "pm.environment.set(\"token\", body.data.jwtToken);\r",
                  "pm.environment.set(\"shopperId\", body.data.userId);\r",
                  "pm.environment.set(\"zoneId\", body.data.zoneId);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"email\": \"hussainjj@gmail.com\",\r\n  \"password\": \"Navaz@123456\",\r\n  \"role\": \"SHOPPER\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{ss_url}}/users/login",
              "host": [
                "{{ss_url}}"
              ],
              "path": [
                "users",
                "login"
              ]
            }
          },
          "response": []
        }
